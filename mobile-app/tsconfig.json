{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@shopstock/shared": ["../shared/dist"],
      "@shopstock/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src", "**/*.ts", "**/*.tsx", "index.js", "metro.config.js"],
  "exclude": ["**/node_modules", "**/Pods", "android", "ios", "dist"]
}
