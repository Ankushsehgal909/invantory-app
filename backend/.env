# Application
APP_NAME=ShopStock
APP_VERSION=1.0.0
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
MOBILE_URL=http://localhost:8081

# Database - MongoDB
DATABASE_URL=mongodb://localhost:27017/shopstock

# JWT - Generate strong secrets for production!
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-long-different
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=shopstock
JWT_AUDIENCE=shopstock-app

# Redis (optional)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Email (optional)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shopstock.app

# SMS/WhatsApp (optional)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push Notifications (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shopstock.app

# Logging
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

# Security
BCRYPT_ROUNDS=12
HELMET_ENABLED=true
CORS_ENABLED=true

# WebSocket
WS_ENABLED=true
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=20000

# Sync
SYNC_BATCH_SIZE=100
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY_MS=1000

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups